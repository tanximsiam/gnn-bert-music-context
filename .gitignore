# Raw and processed data are never committed, except the required example
# segment-graph samples (>=20, per project deliverables). Git can't re-include
# a path whose parent directory is excluded, so processed/ subfolders are
# listed individually instead of blanket-excluding data/processed/.
data/raw/
data/processed/graph_cache/
data/processed/melspec_cache/

# Environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Large artifacts
results/checkpoints/
*.pt
*.ckpt
!data/processed/example_graphs/*.pt

# OS/editor
.DS_Store

# Cookies/session files (used by musiccaps_prep.py --cookies for yt-dlp) and secrets
cookies.txt
*cookies*.txt
*.cookies.txt
.env
